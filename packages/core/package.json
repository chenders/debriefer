{
  "name": "debriefer",
  "version": "1.0.1",
  "description": "Multi-source research orchestration engine with reliability scoring, phase-based execution, and AI synthesis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
