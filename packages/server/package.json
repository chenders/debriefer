{
  "name": "@debriefer/server",
  "version": "2.1.0",
  "description": "HTTP server for multi-source research with reliability scoring and AI synthesis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "debriefer",
    "server",
    "research",
    "api"
  ],
  "author": "Chris Henderson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenders/debriefer.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/chenders/debriefer#readme",
  "bugs": {
    "url": "https://github.com/chenders/debriefer/issues"
  },
  "dependencies": {
    "@debriefer/ai": "^2.0.0",
    "@debriefer/core": "^2.0.0",
    "@debriefer/sources": "^2.0.0",
    "cors": "^2",
    "express": "^4",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2"
  }
