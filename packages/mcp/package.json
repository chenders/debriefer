{
  "name": "@debriefer/mcp",
  "version": "2.0.0",
  "description": "Model Context Protocol server for multi-source research with AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "debriefer-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "debriefer",
    "mcp",
    "model-context-protocol",
    "research",
    "ai"
  ],
  "author": "Chris Henderson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenders/debriefer.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/chenders/debriefer#readme",
  "bugs": {
    "url": "https://github.com/chenders/debriefer/issues"
  },
  "dependencies": {
    "@debriefer/ai": "^2.0.0",
    "@debriefer/core": "^2.0.0",
    "@debriefer/sources": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1",
    "zod": "^3"
  }
}
